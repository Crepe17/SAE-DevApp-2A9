<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1050.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.StatsEtGraphiquesController">

    <center>
        <SplitPane dividerPositions="0.45">

            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>

                <Label style="-fx-font-weight: bold;" text="Processus (soumission / début / fin)" />
                <TableView fx:id="processusTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" />
                        <TableColumn fx:id="colSoumission" text="Soumission" />
                        <TableColumn fx:id="colDebut" text="Début" />
                        <TableColumn fx:id="colFin" text="Fin" />
                        <TableColumn fx:id="colRam" text="RAM" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label style="-fx-font-weight: bold;" text="Métriques globales par politique" />
                <TableView fx:id="metriquesTableView" prefHeight="170.0">
                    <columns>
                        <TableColumn fx:id="colAlgo" text="Politique" />
                        <TableColumn fx:id="colAttenteMoy" text="Attente moy." />
                        <TableColumn fx:id="colReponseMoy" text="Réponse moy." />
                        <TableColumn fx:id="colMakespan" text="Makespan" />
                        <TableColumn fx:id="colEnergieConso" text="Énergie cons." />
                        <TableColumn fx:id="colEnergieDispo" text="Énergie dispo" />
                        <TableColumn fx:id="colTauxEnergie" text="Taux (%)" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>

                <BarChart fx:id="metriquesBarChart" title="Comparaison des métriques" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Politique" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Valeur" />
                    </yAxis>
                </BarChart>

                <LineChart fx:id="energieLineChart" createSymbols="false" title="Énergie consommée vs disponible" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <NumberAxis label="Temps" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Énergie" />
                    </yAxis>
                </LineChart>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>